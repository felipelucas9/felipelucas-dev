---
import "../styles/global.css";

const {
  title = "Felipe Lucas | Front-end Developer & UX/UI Designer",
  description = "Front-end developer focused on clean design, performance and user experience. I build modern websites that convert.",
} = Astro.props;
---

<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.jpg" />

    <meta property="og:url" content="https://felipelucas.dev" />
    <meta
      property="og:site_name"
      content="Felipe Lucas | Front-end Developer & Designer"
    />

    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#8100d1" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
    <script is:inline>
      /* REVEAL ELEMENTS EFFECT */
      const revealElements = document.querySelectorAll(".reveal");

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px",
        },
      );

      revealElements.forEach((el) => revealObserver.observe(el));

      /* OPEN/CLOSE/SEND CONTACT FORM */
      const contactPanel = document.querySelector("[data-contact-panel]");
      const contactOverlay = document.querySelector("[data-contact-overlay]");
      const contactOpenButtons = document.querySelectorAll(
        "[data-contact-open]",
      );
      const contactCloseButton = document.querySelector("[data-contact-close]");
      const contactForm = document.querySelector("[data-contact-form]");
      const contactFeedback = document.querySelector("[data-contact-feedback]");
      const contactSubmit = document.querySelector("[data-contact-submit]");

      const successMsg =
        contactForm?.dataset.success || "Message sent successfully!";
      const errorMsg =
        contactForm?.dataset.error || "Something went wrong. Please try again.";
      const errorNetworkMsg =
        contactForm?.dataset.errorNetwork ||
        "Unable to send right now. Please try again in a moment.";

      const openContactPanel = () => {
        if (!contactPanel || !contactOverlay) return;

        contactPanel.setAttribute("data-open", "true");
        contactPanel.setAttribute("aria-hidden", "false");
        contactOverlay.setAttribute("data-open", "true");
        document.body.style.overflow = "hidden";
      };

      const closeContactPanel = () => {
        if (!contactPanel || !contactOverlay) return;

        contactPanel.setAttribute("data-open", "false");
        contactPanel.setAttribute("aria-hidden", "true");
        contactOverlay.setAttribute("data-open", "false");
        document.body.style.overflow = "";
      };

      contactOpenButtons.forEach((button) => {
        button.addEventListener("click", openContactPanel);
      });

      contactCloseButton?.addEventListener("click", closeContactPanel);
      contactOverlay?.addEventListener("click", closeContactPanel);

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeContactPanel();
        }
      });

      if (contactForm) {
        contactForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!contactSubmit || !contactFeedback) return;

          const form = event.currentTarget;
          const formData = new FormData(form);
          const originalButtonText = contactSubmit.textContent;

          contactSubmit.disabled = true;
          contactSubmit.textContent = contactSubmit.dataset.sending;
          contactFeedback.textContent = "";
          contactFeedback.className = "min-h-[24px] text-sm text-white/85";

          try {
            const response = await fetch(form.action, {
              method: "POST",
              body: formData,
              headers: {
                Accept: "application/json",
              },
            });

            if (response.ok) {
              contactFeedback.textContent = successMsg;
              contactFeedback.className = "min-h-[24px] text-sm text-green-300";
              form.reset();

              setTimeout(() => {
                closeContactPanel();
                contactFeedback.textContent = "";
                contactFeedback.className =
                  "min-h-[24px] text-sm text-white/85";
              }, 1400);
            } else {
              contactFeedback.textContent = errorMsg;
              contactFeedback.className = "min-h-[24px] text-sm text-red-300";
            }
          } catch (error) {
            contactFeedback.textContent = errorNetworkMsg;
            contactFeedback.className = "min-h-[24px] text-sm text-red-300";
          } finally {
            contactSubmit.disabled = false;
            contactSubmit.textContent = originalButtonText;
          }
        });
      }
    </script>
  </body>
</html>
