---
// HeroAnimation.astro — Decorative floating elements, vibrant theme
---

<div class="ha-root" aria-hidden="true">

  <!-- Laptop — left side -->
  <div class="ha-device ha-laptop">
    <div class="ha-laptop-screen" style="background:#462C7D;border:2px solid #b500b2;box-shadow:0 6px 28px rgba(181,0,178,0.5)">
      <div class="ha-dots">
        <span class="ha-dot" style="background:#ff5f57"></span>
        <span class="ha-dot" style="background:#febc2e"></span>
        <span class="ha-dot" style="background:#28c840"></span>
      </div>
      <div class="ha-code-lines">
        <div class="ha-code-line" style="width:72%;background:#ff52a0"></div>
        <div class="ha-code-line" style="width:48%;background:#9FFF7C"></div>
        <div class="ha-code-line" style="width:80%;background:rgba(255,255,255,0.45)"></div>
        <div class="ha-code-line" style="width:38%;background:#9FFF7C"></div>
        <div class="ha-code-line" style="width:60%;background:#ff52a0"></div>
      </div>
    </div>
    <div class="ha-laptop-base" style="background:#b500b2;border:2px solid #b500b2;border-top:none;box-shadow:0 6px 16px rgba(181,0,178,0.45)"></div>
  </div>

  <!-- Phone — right side -->
  <div class="ha-device ha-phone" style="background:#b500b2;border:2px solid #ff52a0;box-shadow:0 6px 28px rgba(255,82,160,0.5)">
    <div class="ha-phone-notch" style="background:rgba(255,255,255,0.45)"></div>
    <div class="ha-phone-header" style="background:rgba(255,255,255,0.25)"></div>
    <div class="ha-phone-line" style="background:rgba(255,255,255,0.3)"></div>
    <div class="ha-phone-line ha-phone-line-short" style="background:rgba(255,255,255,0.3)"></div>
    <div class="ha-phone-icons">
      <span class="ha-phone-icon" style="background:#462C7D"></span>
      <span class="ha-phone-icon" style="background:#9FFF7C"></span>
      <span class="ha-phone-icon" style="background:rgba(255,255,255,0.55)"></span>
    </div>
    <div class="ha-phone-home" style="background:rgba(255,255,255,0.35)"></div>
  </div>

  <!-- Tablet — bottom left -->
  <div class="ha-device ha-tablet" style="background:#462C7D;border:2px solid #9FFF7C;box-shadow:0 6px 28px rgba(70,44,125,0.5)">
    <div class="ha-tablet-cards">
      <div class="ha-tablet-card" style="background:#ff52a0"></div>
      <div class="ha-tablet-card" style="background:#9FFF7C"></div>
    </div>
    <div class="ha-tablet-lines">
      <div class="ha-tablet-line" style="width:80%;background:rgba(255,255,255,0.55)"></div>
      <div class="ha-tablet-line" style="width:55%;background:rgba(255,255,255,0.55)"></div>
    </div>
  </div>

  <!-- Floating HTML tags — vibrant solid backgrounds -->
  <span class="ha-tag ha-tag-1" style="background:#462C7D;color:#fff;box-shadow:0 3px 14px rgba(70,44,125,0.5)">&lt;div&gt;</span>
  <span class="ha-tag ha-tag-2" style="background:#b500b2;color:#fff;box-shadow:0 3px 14px rgba(181,0,178,0.5)">&lt;h1&gt;</span>
  <span class="ha-tag ha-tag-3" style="background:#462C7D;color:#fff;box-shadow:0 3px 14px rgba(70,44,125,0.5)">&lt;/section&gt;</span>
  <span class="ha-tag ha-tag-4" style="background:#ff52a0;color:#fff;box-shadow:0 3px 14px rgba(255,82,160,0.5)">&lt;img /&gt;</span>
  <span class="ha-tag ha-tag-5" style="background:#9FFF7C;color:#1a4a00;box-shadow:0 3px 14px rgba(159,255,124,0.55)">&#123; props &#125;</span>
  <span class="ha-tag ha-tag-6" style="background:#ff52a0;color:#fff;box-shadow:0 3px 14px rgba(255,82,160,0.5)">&lt;App /&gt;</span>

  <!-- Laptop mobile — bottom left, only visible on mobile -->
  <div class="ha-device ha-laptop-mobile">
    <div class="ha-laptop-screen" style="background:#462C7D;border:2px solid #b500b2;box-shadow:0 6px 28px rgba(181,0,178,0.5)">
      <div class="ha-dots">
        <span class="ha-dot" style="background:#ff5f57"></span>
        <span class="ha-dot" style="background:#febc2e"></span>
        <span class="ha-dot" style="background:#28c840"></span>
      </div>
      <div class="ha-code-lines">
        <div class="ha-code-line" style="width:72%;background:#ff52a0"></div>
        <div class="ha-code-line" style="width:48%;background:#9FFF7C"></div>
        <div class="ha-code-line" style="width:80%;background:rgba(255,255,255,0.45)"></div>
        <div class="ha-code-line" style="width:38%;background:#9FFF7C"></div>
      </div>
    </div>
    <div class="ha-laptop-base" style="background:#b500b2;border:2px solid #b500b2;border-top:none;box-shadow:0 6px 16px rgba(181,0,178,0.45)"></div>
  </div>

  <!-- Phone mobile — bottom right, only visible on mobile -->
  <div class="ha-device ha-phone-mobile" style="background:#462C7D;border:2px solid #9FFF7C;box-shadow:0 6px 24px rgba(70,44,125,0.5)">
    <div class="ha-phone-notch" style="background:rgba(159,255,124,0.5)"></div>
    <div class="ha-phone-header" style="background:rgba(255,255,255,0.25)"></div>
    <div class="ha-phone-line" style="background:rgba(255,255,255,0.3)"></div>
    <div class="ha-phone-line ha-phone-line-short" style="background:rgba(255,255,255,0.3)"></div>
    <div class="ha-phone-icons">
      <span class="ha-phone-icon" style="background:#ff52a0"></span>
      <span class="ha-phone-icon" style="background:#9FFF7C"></span>
      <span class="ha-phone-icon" style="background:#b500b2"></span>
    </div>
    <div class="ha-phone-home" style="background:rgba(255,255,255,0.35)"></div>
  </div>

  <!-- Cursor decoration -->
  <div class="ha-cursor">
    <svg width="16" height="20" viewBox="0 0 20 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 2L16 12L10 13L13 22L10 23L7 14L2 18L4 2Z" fill="#ff52a0" stroke="#462C7D" stroke-width="1.5"/>
    </svg>
    <span class="ha-cursor-label" style="background:#462C7D;color:#fff;box-shadow:0 3px 10px rgba(70,44,125,0.45)">click</span>
  </div>
</div>

<style>
  .ha-root {
    position: absolute;
    inset: 0;
    background: transparent;
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }

  .ha-device {
    position: absolute;
    will-change: transform;
  }

  /* ── Laptop ─────────────────────────────────────────────── */
  .ha-laptop {
    top: 60px;
    left: 28px;
    width: 142px;
    background: transparent;
    animation: ha-float-a 6s ease-in-out infinite;
    transform: perspective(600px) rotateX(8deg) rotateY(-10deg);
  }

  .ha-laptop-screen {
    border-radius: 8px 8px 0 0;
    padding: 10px 10px 12px;
  }

  .ha-laptop-base {
    border-radius: 0 0 4px 4px;
    height: 9px;
    width: 100%;
  }

  .ha-dots {
    display: flex;
    gap: 5px;
    margin-bottom: 8px;
  }

  .ha-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .ha-code-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ha-code-line {
    height: 4px;
    border-radius: 2px;
  }

  /* ── Phone (desktop) ────────────────────────────────────── */
  .ha-phone {
    top: 48px;
    right: 28px;
    width: 68px;
    min-height: 124px;
    border-radius: 14px;
    padding: 12px 8px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    animation: ha-float-b 7s ease-in-out infinite;
  }

  .ha-phone-notch {
    width: 22px;
    height: 5px;
    border-radius: 3px;
    margin-bottom: 4px;
  }

  .ha-phone-header {
    width: 100%;
    height: 16px;
    border-radius: 5px;
  }

  .ha-phone-line {
    width: 90%;
    height: 4px;
    border-radius: 2px;
  }

  .ha-phone-line-short { width: 65%; }

  .ha-phone-icons {
    display: flex;
    gap: 5px;
    margin-top: 4px;
  }

  .ha-phone-icon {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    display: inline-block;
  }

  .ha-phone-home {
    width: 26px;
    height: 4px;
    border-radius: 2px;
    margin-top: auto;
  }

  /* ── Tablet ─────────────────────────────────────────────── */
  .ha-tablet {
    bottom: 100px;
    left: 28px;
    width: 170px;
    border-radius: 12px;
    padding: 12px;
    animation: ha-float-c 8s ease-in-out infinite;
  }

  .ha-tablet-cards {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }

  .ha-tablet-card {
    flex: 1;
    height: 38px;
    border-radius: 6px;
  }

  .ha-tablet-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ha-tablet-line {
    height: 4px;
    border-radius: 2px;
  }

  /* ── Float keyframes ────────────────────────────────────── */
  @keyframes ha-float-a {
    0%, 100% { transform: perspective(600px) rotateX(8deg) rotateY(-10deg) translateY(0px); }
    50%       { transform: perspective(600px) rotateX(8deg) rotateY(-10deg) translateY(-10px); }
  }
  @keyframes ha-float-b {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-12px); }
  }
  @keyframes ha-float-c {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-8px); }
  }

  /* ── HTML Tags ──────────────────────────────────────────── */
  .ha-tag {
    position: absolute;
    font-family: monospace;
    font-size: 12px;
    font-weight: 600;
    border-radius: 5px;
    padding: 3px 8px;
    will-change: transform;
  }

  .ha-tag-1 { top: 10%;    left: 20%;  animation: ha-tag-float-1 5.2s ease-in-out infinite; }
  .ha-tag-2 { top: 48%;    left:  6%;  animation: ha-tag-float-2 6.1s ease-in-out infinite 0.4s; }
  .ha-tag-3 { top: 14%;    right: 18%; animation: ha-tag-float-3 5.7s ease-in-out infinite 1.1s; }
  .ha-tag-4 { top: 52%;    right:  6%; animation: ha-tag-float-4 6.8s ease-in-out infinite 0.7s; }
  .ha-tag-5 { bottom: 22%; left: 22%;  animation: ha-tag-float-5 5.5s ease-in-out infinite 0.2s; }
  .ha-tag-6 { bottom: 26%; right: 18%; animation: ha-tag-float-6 7.5s ease-in-out infinite 1.5s; }

  @keyframes ha-tag-float-1 {
    0%, 100% { transform: translateY(0px) rotate(-2deg); }
    50%       { transform: translateY(-8px) rotate(1deg); }
  }
  @keyframes ha-tag-float-2 {
    0%, 100% { transform: translateY(0px) rotate(1deg); }
    50%       { transform: translateY(-10px) rotate(-1deg); }
  }
  @keyframes ha-tag-float-3 {
    0%, 100% { transform: translateY(0px) rotate(-1deg); }
    50%       { transform: translateY(-7px) rotate(2deg); }
  }
  @keyframes ha-tag-float-4 {
    0%, 100% { transform: translateY(0px) rotate(2deg); }
    50%       { transform: translateY(-9px) rotate(-2deg); }
  }
  @keyframes ha-tag-float-5 {
    0%, 100% { transform: translateY(0px) rotate(-1deg); }
    50%       { transform: translateY(-6px) rotate(1deg); }
  }
  @keyframes ha-tag-float-6 {
    0%, 100% { transform: translateY(0px) rotate(1deg); }
    50%       { transform: translateY(-11px) rotate(-1deg); }
  }

  /* ── Cursor ─────────────────────────────────────────────── */
  .ha-cursor {
    position: absolute;
    bottom: 90px;
    right: 28px;
    display: flex;
    align-items: flex-end;
    gap: 4px;
  }

  .ha-cursor-label {
    font-family: monospace;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    padding: 1px 6px;
    margin-bottom: 2px;
  }

  /* ── Laptop mobile-only ─────────────────────────────────── */
  .ha-laptop-mobile {
    display: none;
    bottom: 90px;
    left: 30px;
    width: 120px;
    background: transparent;
    animation: ha-float-a 6.5s ease-in-out infinite 0.3s;
    transform: perspective(600px) rotateX(8deg) rotateY(-10deg);
  }

  /* ── Phone mobile-only ──────────────────────────────────── */
  .ha-phone-mobile {
    display: none;
    bottom: 80px;
    right: 50px;
    left: auto;
    transform: none;
    width: 62px;
    min-height: 116px;
    border-radius: 14px;
    padding: 12px 8px 8px;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    animation: ha-float-b 7s ease-in-out infinite 0.8s;
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .ha-laptop, .ha-tablet { display: none; }
    .ha-phone { top: 32px; right: 10px; width: 58px; min-height: 108px; }
  }

  @media (max-width: 768px) {
    .ha-phone, .ha-tag-5, .ha-tag-6, .ha-cursor { display: none; }
    .ha-phone-mobile  { display: flex; }
    .ha-laptop-mobile { display: block; }
    .ha-tag-1 { top: 6%;      left: 4%;  }
    .ha-tag-2 { bottom: 72px; left: 4%;  }
    .ha-tag-3 { top: 6%;      right: 4%; }
    .ha-tag-4 { bottom: 72px; right: 4%; }
  }

  @media (max-width: 480px) {
    .ha-tag-2, .ha-tag-4 { display: none; }
  }

  /* ── Reduced motion ─────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ha-device, .ha-tag { animation: none !important; }
    .ha-laptop, .ha-laptop-mobile {
      transform: perspective(600px) rotateX(8deg) rotateY(-10deg);
    }
  }
</style>
