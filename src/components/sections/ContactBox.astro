---
import Container from "../ui/Container.astro";

const { t } = Astro.props;
---

<div
  class="reveal reveal-delay-2 absolute left-1/2 bottom-0 z-10 w-full -translate-x-1/2 translate-y-1/2"
>
  <Container>
    <div
      class="mx-auto w-[92%] max-w-5xl rounded-3xl bg-white px-5 py-6 shadow-[0_20px_60px_rgba(0,0,0,0.35)] sm:px-8 md:px-10 md:py-8"
    >
      <div
        class="flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:text-left"
      >
        <div class="max-w-xs">
          <h3 class="text-lg font-bold text-[var(--color-text-title)]">
            {t.contact.title}
          </h3>
        </div>

        <div class="max-w-md">
          <p class="text-sm leading-6 text-[var(--color-text)]">
            {t.contact.description}
          </p>
        </div>

        <button
          type="button"
          class="inline-block rounded-full border-2 border-[var(--color-accent)] px-5 py-2 text-sm font-medium text-[var(--color-accent)] transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-[var(--color-accent)] hover:text-white hover:shadow-lg data-contact-open"
          data-contact-open
        >
          {t.contact.cta}
        </button>
      </div>
    </div>
  </Container>
</div>
