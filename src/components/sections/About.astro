---
import Container from "../ui/Container.astro";

const { t, lang } = Astro.props;
---

<section
  id="about"
  class="relative bg-[var(--color-primary)] pt-32 pb-20 text-white"
>
  <Container>
    <div class="mx-auto max-w-4xl text-center">
      <h3 class="text-3xl font-bold leading-tight sm:text-4xl">
        {t.about.title}
      </h3>

      <p class="mt-6 text-base leading-8 text-white/90 sm:text-lg">
        {t.about.text1}
      </p>

      <p class="mt-4 text-base leading-8 text-white/90 sm:text-lg">
        {t.about.text2}
      </p>
    </div>
  </Container>
</section>
