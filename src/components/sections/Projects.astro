---
import Container from "../ui/Container.astro";

const { t } = Astro.props;
---

<section id="projects" class="pb-24">
  <Container>
    <div class="reveal reveal-delay-1 mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-[var(--color-text-title)] sm:text-4xl">
        {t.projects.title}
      </h2>

      <p class="mt-4 text-base leading-8 text-[var(--color-text)] sm:text-lg">
        {t.projects.description}
      </p>
    </div>

    <div class="reveal reveal-delay-3 mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {t.projects.items.map((project) => (
        <article class="project-card h-48">
          <div class="project-card-inner">
            <!-- Frente -->
            <div class="project-card-face flex h-full flex-col items-center justify-center rounded-2xl bg-[var(--color-accent)] px-6 text-center text-white shadow-md transition duration-300">
              <div class="mb-3 flex justify-center">
                <img src={project.logo} alt={project.company} class="h-14 w-auto object-contain " />
              </div>

              <h3 class="text-lg font-semibold">
                {project.company}
              </h3>
            </div>

            <!-- Verso -->
            <div class="project-card-face project-card-back flex h-full flex-col items-center justify-center rounded-2xl bg-[var(--color-primary)] px-5 text-center text-white shadow-lg transition duration-300 project-glow">
              <p class="text-sm leading-6">
                {project.summary}
              </p>

              <a
                href={project.href}
                class="mt-4 inline-flex rounded-full border border-white px-4 py-2 text-sm font-medium text-white transition hover:bg-white hover:text-[var(--color-primary)]"
              >
                {project.button}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>